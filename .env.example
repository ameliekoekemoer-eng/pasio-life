NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Needed for the server-side API routes (contact messages, bookings, admin)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Admin calendar (/admin) — change these in production
ADMIN_PASSWORD="pasio-life-admin"
ADMIN_SESSION_TOKEN="your-long-random-session-token"

# Booking email notifications (optional — bookings always save to Supabase)
BOOKING_NOTIFY_EMAIL="hello@pasio.life"
PASIO_EMAIL="hello@pasio.life"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

