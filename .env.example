NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Needed for the server-side API routes (contact messages, subscriptions, admin)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Admin availability calendar (/admin) — change these in production
ADMIN_PASSWORD="pasio-life-admin"
ADMIN_SESSION_TOKEN="your-long-random-session-token"

# Optional: lets /admin/bookings be opened via ?token=... without signing in
BOOKING_ADMIN_TOKEN="your-long-random-token"

